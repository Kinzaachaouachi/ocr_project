# ═══════════════════════════════════════════════════════════════════════════════
# OCR Intelligence — Variables d'environnement (exemple)
# Copiez ce fichier vers .env et renseignez les valeurs.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ocr_intelligence

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=changez_moi_par_une_cle_longue_et_aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── URL publique de l'app (liens dans les emails) ──────────────────────────────
APP_BASE_URL=http://localhost:8000

# ── SMTP / Email (OBLIGATOIRE pour envoyer vraiment les mails) ─────────────────
# Pour Gmail:
#   1. Activez la validation en 2 étapes:
#      https://myaccount.google.com/security
#   2. Créez un "Mot de passe d'application" (16 caractères):
#      https://myaccount.google.com/apppasswords
#   3. Collez ce mot de passe ICI (PAS le mot de passe du compte Google)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=votre.email@gmail.com
SMTP_FROM_NAME=OCR Intelligence

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── Upload (optionnel — aussi défini dans app/config/settings.py) ───────────────
# MAX_FILE_SIZE=10485760
